{
	"name": "ganzo-video-converter",
	"version": "1.0.0",
	"description": "Ganzo video converter for different video formats, audio extractor, audio replacer, and any quick and simple operation made for videos.",
	"homepage": "https://github.com/AntosDR/ganzo-video-converter#readme",
	"bugs": {
		"url": "https://github.com/AntosDR/ganzo-video-converter.git/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AntosDR/ganzo-video-converter.git"
	},
	"contributors": [
		{
			"name": "AntosDR",
			"url": "https://github.com/AntosDR"
		}
	],
	"main": "./release/app/dist/main/main.js",
	"scripts": {
		"start": "electron-vite preview -- --ozone-platform=x11",
		"dev": "electron-vite dev -- --ozone-platform=x11",
		"build": "electron-vite build",
		"format": "prettier --write .",
		"postinstall": "npm --prefix .erb/tooling ci && install-electron && electron-builder install-app-deps",
		"lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx,.cjs",
		"lint:fix": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx,.cjs --fix",
		"package": "npm run build && electron-builder build --publish never",
		"rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "jest --runInBand",
		"test:e2e": "playwright test e2e --workers=1",
		"test:smoke": "node .erb/scripts/smoke-test.cjs",
		"preview": "electron-vite preview"
	},
	"browserslist": [
		"electron 44.4"
	],
	"dependencies": {
		"@electron/notarize": "^3.1.1",
		"electron-debug": "^4.1.0",
		"electron-log": "^5.4.4",
		"electron-updater": "^6.8.9",
		"ffmpeg-static-electron": "^2.0.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"swiper": "^14.3.0"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.2.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.65.1",
		"@swc/core": "^1.16.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/node": "26.6.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-test-renderer": "^19.3.0",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-react": "^5.2.0",
		"browserslist-config-erb": "^0.0.3",
		"cross-env": "^10.1.0",
		"electron": "^44.4.0",
		"electron-builder": "^26.15.3",
		"electron-devtools-installer": "^4.0.0",
		"electron-vite": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"prettier": "^3.9.6",
		"react-test-renderer": "^19.3.0",
		"sass": "^1.104.1",
		"svgo": "^4.1.0",
		"type-fest": "^5.9.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"vite-plugin-svgr": "^4.5.0"
	},
	"build": {
		"productName": "Ganzo Media Converter",
		"publish": {
			"provider": "github",
			"releaseType": "prerelease",
			"vPrefixedTagName": false,
			"owner": "AntosDR",
			"repo": "ganzo-video-converter"
		},
		"appId": "it.antosdr.ganzo-video-converter",
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"asar": true,
		"afterSign": ".erb/scripts/notarize.js",
		"asarUnpack": "**\\*.{node,dll}",
		"files": [
			"dist",
			"node_modules",
			"package.json"
		],
		"mac": {
			"notarize": false,
			"target": {
				"target": "default",
				"arch": [
					"arm64",
					"x64"
				]
			},
			"type": "distribution",
			"hardenedRuntime": true,
			"entitlements": "assets/entitlements.mac.plist",
			"entitlementsInherit": "assets/entitlements.mac.plist",
			"gatekeeperAssess": false,
			"extraResources": [
				{
					"from": "node_modules/ffmpeg-static-electron/bin/mac",
					"to": "ffmpeg/mac",
					"filter": [
						"${arch}/ffmpeg"
					]
				}
			]
		},
		"dmg": {
			"contents": [
				{
					"x": 130,
					"y": 220
				},
				{
					"x": 410,
					"y": 220,
					"type": "link",
					"path": "/Applications"
				}
			]
		},
		"win": {
			"target": [
				{
					"target": "portable",
					"arch": [
						"x64",
						"ia32"
					]
				},
				{
					"target": "nsis",
					"arch": [
						"x64",
						"ia32"
					]
				}
			],
			"icon": "build/icon.ico",
			"extraResources": [
				{
					"from": "node_modules/ffmpeg-static-electron/bin/win",
					"to": "ffmpeg/win",
					"filter": [
						"${arch}/ffmpeg.exe"
					]
				}
			]
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development",
			"extraResources": [
				{
					"from": "node_modules/ffmpeg-static-electron/bin/linux",
					"to": "ffmpeg/linux",
					"filter": [
						"${arch}/ffmpeg"
					]
				}
			]
		},
		"directories": {
			"app": "release/app",
			"buildResources": "assets",
			"output": "release/build"
		},
		"extraResources": [
			"./assets/**"
		]
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=10.0.0",
			"onFail": "error"
		}
	},
	"overrides": {
		"eslint-plugin-react": {
			"eslint": "$eslint"
		},
		"eslint-plugin-import": {
			"eslint": "$eslint"
		},
		"eslint-plugin-jsx-a11y": {
			"eslint": "$eslint"
		},
		"@jest/reporters": {
			"glob": "14.0.2"
		},
		"jest-config": {
			"glob": "14.0.2"
		},
		"jest-runtime": {
			"glob": "14.0.2"
		},
		"test-exclude": {
			"glob": "14.0.2",
			"minimatch": "11.0.1"
		},
		"@electron/universal": {
			"minimatch": "11.0.1"
		},
		"app-builder-lib": {
			"minimatch": "11.0.1"
		}
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=10.0.0"
	},
	"type": "commonjs",
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"@swc/core@1.16.2": true,
		"electron-winstaller@5.4.0": true,
		"unrs-resolver@1.12.2": true,
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true
	}
}
